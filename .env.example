# Flask Secret Key (generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_64_CHAR_HEX_SECRET

# Environment Mode ('production' on Render, 'development' locally)
FLASK_ENV=production

# Supabase PostgreSQL Configuration
USE_POSTGRES=true
SUPABASE_PROJECT_ID=YOUR_SUPABASE_PROJECT_ID
# Optional full project URL alias (auto-derives SUPABASE_PROJECT_ID if omitted)
SUPABASE_URL=https://YOUR_SUPABASE_PROJECT_ID.supabase.co
DB_HOST=db.YOUR_SUPABASE_PROJECT_ID.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_NAME=postgres
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.YOUR_SUPABASE_PROJECT_ID.supabase.co:5432/postgres

# Supabase Storage & API Keys (SUPABASE_SERVICE_ROLE_KEY is server-side ONLY)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_API_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Optional alias for SUPABASE_API_KEY
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Gemini AI API Key (server-side ONLY)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Cookie / Frame Hardening (defaults are secure: Lax cookies, framing denied)
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
ALLOW_IFRAME_EMBED=false

# Disable demo account auto-seeding in production
ENABLE_DEMO_SEED=false

# Optional comma-separated list of trusted CORS origins
CORS_ALLOWED_ORIGINS=

# SQLite Database Path (fallback if USE_POSTGRES is disabled)
DATABASE_PATH=database/student_exchange.db
